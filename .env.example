# ===== App =====
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CLIENT_URL=http://localhost:5173

# ===== MongoDB =====
MONGO_URI=mongodb://127.0.0.1:27017/hr_booking

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379

# ===== Auth (required in production) =====
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFY_EMAIL_EXPIRES_IN=24h
JWT_RESET_PASSWORD_EXPIRES_IN=1h

# Bootstrap super admin (only used by seed script / first boot)
SUPER_ADMIN_EMAIL=admin@hrbooking.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# ===== Email transport =====
# console = print emails to stdout (dev default), smtp = send via SMTP (Mailpit in dev)
EMAIL_TRANSPORT=console

# ===== Google OAuth (Google Meet / Calendar) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/callback

# ===== Zoom OAuth =====
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:5000/api/v1/integrations/zoom/callback

# ===== SMTP (Mailpit by default in dev) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@hrbooking.local

# ===== Payments =====
PAYMENT_API_KEY=
PAYMENT_SECRET=
